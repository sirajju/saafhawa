# ==========================================
# SAAFHAWA - Environment Variables Template
# ==========================================
# SECURITY NOTICE:
# DO NOT expose API keys or secrets to the client.
# Do NOT prefix sensitive variables with NEXT_PUBLIC_.
# These keys are only accessible on the server side (Route Handlers, Server Actions, Server Components).

# ------------------------------------------
# Google Maps Platform (Server-Only)
# ------------------------------------------
# Unified key for Google Geocoding API & Google Air Quality API
GOOGLE_MAPS_API_KEY=your_google_maps_platform_api_key_here

# ------------------------------------------
# Google Gemini AI (Server-Only)
# ------------------------------------------
# Primary API key for Gemini assistant and plan generation (AI_API_KEY also accepted as fallback)
GEMINI_API_KEY=your_gemini_api_key_here
# AI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------
# Application Configuration
# ------------------------------------------
NODE_ENV=development
