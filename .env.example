# ==========================================
# SAAFHAWA - Environment Variables Template
# ==========================================
# SECURITY NOTICE:
# DO NOT expose API keys or secrets to the client.
# Do NOT prefix sensitive variables with NEXT_PUBLIC_.
# These keys are only accessible on the server side (Route Handlers, Server Actions, Server Components).

# ------------------------------------------
# Google Gemini AI (Server-Only - Optional (enables AI))
# ------------------------------------------
# API key for Gemini assistant and plan generation (from Google AI Studio - free tier available; optional - enables AI)
GEMINI_API_KEY=your_gemini_api_key_here
# Ordered list of models to try in sequence. On free tier (20 requests/day/model), each model has its own
# separate daily quota. When a model's daily quota is exhausted, SAAFHAWA automatically skips it and moves
# to the next candidate model in the chain.
GEMINI_MODELS=gemini-flash-lite-latest,gemini-2.5-flash-lite,gemini-3.8-flash
# Backwards-compatible single-model overrides (used if GEMINI_MODELS is not set):
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# ------------------------------------------
# World Air Quality Index (WAQI) (Server-Only - Optional)
# ------------------------------------------
# Free token from https://aqicn.org/api/
# When set, queries the nearest CPCB ground monitoring station feed for street-level PM2.5/PM10 readings.
# Falls back gracefully to Open-Meteo when unset or unreachable.
WAQI_TOKEN=

# ------------------------------------------
# Google Maps Platform (Server-Only - Optional Upgrade)
# ------------------------------------------
# Optional upgrade key for Google Geocoding API & Google Air Quality API
# When unset or quota-exhausted, the app automatically runs on Open-Meteo (zero cost, no key required).
GOOGLE_MAPS_API_KEY=

# ------------------------------------------
# Reverse Proxy & Rate Limiting Configuration
# ------------------------------------------
# Number of trusted reverse proxy hops between user and application.
# Google Cloud Run default: 1 (Cloud Run acts as the single reverse proxy).
# If behind Google Cloud Load Balancing (GCLB) + Cloud Run: set to 2.
# On Vercel: Vercel edge proxy manages client IP extraction automatically.
# When unset or TRUSTED_PROXY_HOPS=0 (direct access / unknown proxy), the app falls back
# to a single shared safety rate limiter rather than spoofable client-supplied headers.
TRUSTED_PROXY_HOPS=1

# ------------------------------------------
# Application Configuration
# ------------------------------------------
NODE_ENV=development
